# Copia este archivo como .streamlit/secrets.toml para ejecución local.
# En Streamlit Community Cloud agrega el mismo valor en App settings > Secrets.
BIG_BOSS_PASSWORD = "Admin"

# ID del Google Sheet DATA_TRANSFERS (entre /d/ y /edit en su URL). El Sheet
# debe estar publicado como "Cualquier persona con el enlace: Lector".
# NUNCA pongas el ID real en el código ni en el README — solo aquí.
DATA_TRANSFERS_SPREADSHEET_ID = "reemplace-esto-por-el-id-real-del-sheet"

# ID del Google Sheet DATA_DASHBOARD que usa Militaires Sans Frontières.
DATA_DASHBOARD_SPREADSHEET_ID = "reemplace-esto-por-el-id-real-del-sheet"

# --- Militaires Sans Frontières: carga diaria desde Snowflake vía Drive ---
# ID de la carpeta del Drive compartido donde se guardan los snapshots
# diarios y el rollup histórico (lo ves en la URL de la carpeta, después de
# /folders/).
DATA_DASHBOARD_DRIVE_FOLDER_ID = "reemplace-esto-por-el-id-real-de-la-carpeta"

# Opcional: correo de Workspace que la cuenta de servicio suplanta (Domain-
# Wide Delegation), en vez de actuar con su propia identidad. Necesario si
# tu organización tiene políticas de DLP/clasificación (por ejemplo,
# etiquetas "Confidential") que bloquean el acceso de cuentas de servicio
# aunque tengan permiso de carpeta — al suplantar a un usuario real, la
# cuenta de servicio hereda los permisos de ESE usuario. Requiere que un
# admin de Workspace autorice el Client ID de la cuenta de servicio en
# Admin Console → Seguridad → Controles de API → Delegación en todo el
# dominio, con el scope https://www.googleapis.com/auth/drive. Déjalo vacío
# o coméntalo si no lo necesitas.
DATA_DASHBOARD_IMPERSONATE_EMAIL = "tu-correo@tu-empresa.com"

# --- Alternativa a lo anterior cuando no hay admin de Workspace disponible:
# OAuth de usuario. Tú autorizas una sola vez con tu propia cuenta desde el
# botón "Conectar mi cuenta personal de Google" del módulo, y pegas aquí el
# refresh token que te muestra. Client ID/Secret salen de un "ID de cliente
# de OAuth" (tipo Aplicación web) creado en el mismo proyecto de Google
# Cloud — no requiere aprobación de admin de Workspace. Si configuras esto,
# tiene prioridad sobre [gcp_service_account]/IMPERSONATE_EMAIL de arriba.
DATA_DASHBOARD_OAUTH_CLIENT_ID = "reemplace-esto.apps.googleusercontent.com"
DATA_DASHBOARD_OAUTH_CLIENT_SECRET = "reemplace-esto"
DATA_DASHBOARD_OAUTH_REDIRECT_URI = "https://su-app.streamlit.app"
# Este se llena DESPUÉS de completar el flujo de conexión una vez — déjalo
# vacío la primera vez que despliegues.
DATA_DASHBOARD_OAUTH_REFRESH_TOKEN = ""

# Contenido completo del JSON de la cuenta de servicio de Google Cloud
# (Google Drive API habilitada, agregada como Content Manager del Drive
# compartido). Pega aquí exactamente los campos del archivo .json que
# descargaste — nunca subas ese .json al repo.
[gcp_service_account]
type = "service_account"
project_id = "reemplace-esto"
private_key_id = "reemplace-esto"
private_key = "-----BEGIN PRIVATE KEY-----\nreemplace-esto\n-----END PRIVATE KEY-----\n"
client_email = "reemplace-esto@reemplace-esto.iam.gserviceaccount.com"
client_id = "reemplace-esto"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "reemplace-esto"
universe_domain = "googleapis.com"

